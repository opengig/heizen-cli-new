{
  "name": "heizen-cli",
  "version": "1.0.0",
  "module": "index.ts",
  "type": "module",
  "private": false,
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "@types/prompts": "^2.4.9",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.15.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "lowdb": "^7.0.1",
    "prompts": "^2.4.2",
    "chalk": "^5.6.2",
    "zod": "^3.24.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "keytar": "^7.9.0",
    "listr2": "^10.2.1",
    "ora": "^9.3.0",
    "open": "^11.0.0"
  },
  "bin": {
    "hz": "dist/bin/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/bin/index.ts",
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "type-check": "tsc --noEmit",
    "start": "node dist/bin/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  }
}