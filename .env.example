# Heizen CLI - Auth credentials (copy to .env and fill in)
# Never commit .env - it is gitignored

# Worklog API (worklog.opengig.work) - Cookie auth
# Get from browser devtools when logged into worklog
HEIZEN_WORKLOG_COOKIE=_auth=...; timezone=Asia/Calcutta

# Dashboard API (api.studio.heizen.work) - Bearer token
# JWT from dashboard auth
HEIZEN_DASHBOARD_TOKEN=Bearer eyJ...
